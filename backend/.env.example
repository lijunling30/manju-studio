# 复制为 .env 并按需修改；默认值可在 app/config.py 查看
# 数据库：默认 SQLite（开箱即用）。生产切换 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/manju

# ============ 模式开关 ============
# MOCK_MODE=true 时全部 AI 调用走模拟厂商（无需真实 API Key 即可演示全流程）
# MOCK_MODE=false 时启用真实 AI 厂商（需配置下方 API Key）
MOCK_MODE=true

# ============ 真实 AI 厂商（MOCK_MODE=false 时必填） ============
# 文本：DeepSeek（https://platform.deepseek.com/ 申请 Key）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 图像 + 视频：通义万相 / 阿里云百炼（https://bailian.console.aliyun.com/ 申请 Key）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
DASHSCOPE_VIDEO_MODEL=wanx2.1-i2v-turbo

# 图生视频需要关键帧公网可访问，部署后请填写（例：https://api.example.com 或 OSS 域名）
STORAGE_PUBLIC_BASE=

# 文本生成质量（默认每章 2500 字）
NOVEL_CHAPTER_WORDS=2500
SCRIPT_SCENE_WORDS=400

# ============ 基础配置 ============
JWT_SECRET=please-change-me-in-production
# 确认闸口参数（PRD 5.0.1）
GATE_TIMEOUT_SECONDS=60
GATE_HIGH_COST_THRESHOLD=50
GATE_BATCH_THRESHOLD=20
