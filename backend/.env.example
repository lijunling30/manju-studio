# ============================================================
# 漫镜工场 ManJu Studio · 环境变量配置
# ============================================================
# 使用方法：复制本文件为 .env，按需修改。
# 首次部署可保持 MOCK_MODE=true 体验全流程（无需任何 API Key）。
# 切换真实 AI：MOCK_MODE=false 并填写下方 API Key。

# ============ 模式开关 ============
# true  = 全部 AI 调用走模拟厂商（零配置、零成本，可演示完整流水线）
# false = 启用真实 AI 厂商（需配置下方 API Key）
MOCK_MODE=true

# ============ 文本模型：DeepSeek 官方 API ============
# 申请：https://platform.deepseek.com/
# 模型：deepseek-v4-flash（便宜·推荐）/ deepseek-v4-pro（更强）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ============ 图像 + 视频 + TTS：阿里云百炼 DashScope ============
# 申请：https://bailian.console.aliyun.com/
#
# 两种 Key 类型：
#   1) 套餐 Key（sk-sp- 开头）：走 token-plan.cn-beijing.maas.aliyuncs.com，有 QPS 限制
#   2) 按量计费 Key（sk-ws- 开头）：走 dashscope.aliyuncs.com，不限流，按调用量计费
#
# 推荐：图像/视频用按量计费 Key（避免套餐限流），TTS 用套餐 Key
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com

# 图像模型：万相 2.7（wan2.7-image-pro 高质量 / wan2.7-image 快速）
DASHSCOPE_IMAGE_MODEL=wan2.7-image-pro

# 视频模型：HappyHorse 1.1（happyhorse-1.1-i2v 图生视频 / -t2v 文生视频 / -r2v 参考生视频）
DASHSCOPE_VIDEO_MODEL=happyhorse-1.1-i2v

# TTS 语音合成：Qwen-Audio-TTS（套餐内）
DASHSCOPE_TTS_MODEL=qwen-audio-3.0-tts-plus
DASHSCOPE_TTS_VOICE=longanhuan_v3.6
DASHSCOPE_TTS_FORMAT=mp3

# ============ 按量计费 Key（图像/视频专用，避免套餐 QPS 限流） ============
# 配置后图像/视频自动走 dashscope.aliyuncs.com 通用域名；留空则回退到套餐 Key
DASHSCOPE_PAY_API_KEY=
DASHSCOPE_PAY_BASE_URL=https://dashscope.aliyuncs.com

# ============ 文本生成质量 ============
NOVEL_CHAPTER_WORDS=2500
SCRIPT_SCENE_WORDS=400

# ============ 图生视频公网访问 ============
# 图生视频需要关键帧为公网可访问 URL。
# 本地开发：留空（平台自动复用万相返回的原始公网 URL，无需公网穿透）
# 服务器部署：填写你的公网地址，如 https://api.yourdomain.com
STORAGE_PUBLIC_BASE=

# ============ 基础配置 ============
# JWT 密钥（生产环境请改为随机长字符串）
JWT_SECRET=please-change-me-in-production
# 确认闸口参数（PRD 5.0.1）
GATE_TIMEOUT_SECONDS=60
GATE_HIGH_COST_THRESHOLD=50
GATE_BATCH_THRESHOLD=20

# ============ CORS 跨域 ============
# 前端地址（多个用逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============ 数据库（默认 SQLite，开箱即用） ============
# 生产环境可切换 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/manju
